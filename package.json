{
  "name": "molecules",
  "version": "2026.8.19",
  "description": "JavaScript cheminformatics toolkit for molecular graphs, SMILES/InChI, SMARTS/SMIRKS, 2D layout, and molecular descriptors",
  "type": "module",
  "sideEffects": [
    "./es/index.js",
    "./es/smarts/index.js",
    "./src/index.js",
    "./src/smarts/index.js"
  ],
  "main": "./es/index.js",
  "module": "./es/index.js",
  "exports": {
    ".": {
      "import": "./es/index.js",
      "default": "./es/index.js"
    },
    "./core": {
      "import": "./es/core/index.js"
    },
    "./algorithms": {
      "import": "./es/algorithms/index.js"
    },
    "./matrices": {
      "import": "./es/matrices/index.js"
    },
    "./descriptors": {
      "import": "./es/descriptors/index.js"
    },
    "./data": {
      "import": "./es/data/index.js"
    },
    "./io": {
      "import": "./es/io/index.js"
    },
    "./layout": {
      "import": "./es/layout/index.js"
    },
    "./smarts": {
      "import": "./es/smarts/index.js"
    },
    "./smirks": {
      "import": "./es/smirks/index.js"
    },
    "./utils": {
      "import": "./es/utils/index.js"
    },
    "./validation": {
      "import": "./es/validation/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "es",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "clean": "rimraf lib es dist",
    "prebuild": "npm run clean",
    "test": "node --test 'tests/**/*.test.js'",
    "test:layout:browser": "RUN_BROWSER_LAYOUT_TESTS=1 node --test tests/layout/engine/browser-determinism.test.js",
    "test:layout:stress": "RUN_LAYOUT_STRESS=1 node --test 'tests/layout/engine/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run build && npm run test:package && npm run test",
    "test:package": "node scripts/validation/package-consumer.mjs"
  },
  "keywords": [
    "chemistry",
    "cheminformatics",
    "computational-chemistry",
    "molecule",
    "molecular-graph",
    "smiles",
    "inchi",
    "smarts",
    "smirks",
    "molecular-descriptors",
    "graph-theory",
    "drug-discovery",
    "qsar",
    "chemdraw"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.12"
  }
}
